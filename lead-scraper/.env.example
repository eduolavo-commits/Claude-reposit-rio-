# ============================================================
# Mary Kay Brazil Lead Scraper — Configuração
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ---- Google Sheets ----
# Caminho para o arquivo JSON de credenciais da Service Account
GOOGLE_CREDENTIALS_JSON=credentials.json

# ID da planilha (parte da URL: /spreadsheets/d/ESTE_TRECHO/edit)
GOOGLE_SHEET_ID=your_sheet_id_here

# Nome da aba dentro da planilha
SHEET_TAB_NAME=Leads

# ---- Banco de dados local ----
DB_PATH=leads.db

# ---- Controle de requisições ----
# Delay aleatório entre requests (em segundos)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# CEPs processados por ciclo antes de sincronizar o progresso
BATCH_SIZE=50

# ---- Logs ----
LOG_LEVEL=INFO

# ---- Browser ----
# True para produção (sem janela), False para depuração (mostra o browser)
HEADLESS=True

# ---- URLs do site ----
LOCATOR_BASE_URL=https://www.marykay.com.br/pt-br/locator
PROFILE_BASE_URL=https://www.marykay.com.br/pt-br/locator/profile
